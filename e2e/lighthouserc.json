{
  "ci": {
    "collect": {
      "startServerCommand": "node server.mjs",
      "startServerReadyPattern": "listening",
      "url": ["http://localhost:4173/", "http://localhost:4173/mail", "http://localhost:4173/helpers"],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "localhost:4173/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "localhost:4173/(mail|helpers)$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:performance": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": "./.lighthouseci" }
  }
}
