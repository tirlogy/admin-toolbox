@using AdminToolbox.Core.Helpers

<section class="card" aria-labelledby="h-pw">
    <h2 id="h-pw">@L["helpers.password"]</h2>
    <fieldset class="radio-row">
        <legend>@L["pw.mode"]</legend>
        <label><input type="radio" name="pw-mode" checked="@(!_passphrase)" @onchange="() => SetMode(false)" /> @L["pw.mode.password"]</label>
        <label><input type="radio" name="pw-mode" checked="@_passphrase" @onchange="() => SetMode(true)" /> @L["pw.mode.passphrase"]</label>
    </fieldset>

    @if (_passphrase)
    {
        <div class="field-row">
            <div class="field">
                <label for="pp-words">@L["pw.words"]</label>
                <input id="pp-words" type="number" min="@PasswordGenerator.MinWords" max="@PasswordGenerator.MaxWords" @bind="_words" @bind:after="Generate" />
            </div>
            <div class="field">
                <label for="pp-sep">@L["pw.separator"]</label>
                <input id="pp-sep" type="text" maxlength="3" @bind="_separator" @bind:after="Generate" />
            </div>
        </div>
        <div class="check-row">
            <label><input type="checkbox" @bind="_capitalize" @bind:after="Generate" /> @L["pw.capitalize"]</label>
            <label><input type="checkbox" @bind="_number" @bind:after="Generate" /> @L["pw.number"]</label>
        </div>
        <p class="muted">@L["pw.wordlist"]</p>
    }
    else
    {
        <div class="field">
            <label for="pw-length">@L["pw.length"]</label>
            <input id="pw-length" type="number" min="@PasswordGenerator.MinLength" max="@PasswordGenerator.MaxLength" @bind="_length" @bind:after="Generate" />
        </div>
        <div class="check-row">
            <label><input type="checkbox" @bind="_upper" @bind:after="Generate" /> A–Z</label>
            <label><input type="checkbox" @bind="_lower" @bind:after="Generate" /> a–z</label>
            <label><input type="checkbox" @bind="_digits" @bind:after="Generate" /> 0–9</label>
            <label><input type="checkbox" @bind="_symbols" @bind:after="Generate" /> !#$%</label>
            <label><input type="checkbox" @bind="_noAmbiguous" @bind:after="Generate" /> @L["pw.ambiguous"]</label>
        </div>
    }

    <div class="field">
        <label for="pw-output">@L["pw.result"]</label>
        <div class="output-row">
            <input id="pw-output" class="mono" type="text" readonly value="@_result" />
            <CopyButton Text="@_result" />
            <button type="button" class="btn btn-small" @onclick="Generate">@L["pw.new"]</button>
        </div>
    </div>
    @if (_error is not null)
    {
        <p class="alert" role="alert">@_error</p>
    }
    else
    {
        <p class="strength strength-@((int)_strength)">
            <span class="strength-bar" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
            @L["pw.strength", L["strength." + _strength], Math.Round(_bits)]
        </p>
    }
    <p class="muted">@L["pw.local"]</p>
</section>

@code {
    private bool _passphrase;
    private int _length = 20;
    private bool _upper = true;
    private bool _lower = true;
    private bool _digits = true;
    private bool _symbols = true;
    private bool _noAmbiguous;
    private int _words = 5;
    private string _separator = "-";
    private bool _capitalize = true;
    private bool _number = true;
    private string _result = string.Empty;
    private string? _error;
    private double _bits;
    private Strength _strength;

    protected override void OnInitialized() => Generate();

    private void SetMode(bool passphrase)
    {
        _passphrase = passphrase;
        Generate();
    }

    private void Generate()
    {
        _error = null;
        try
        {
            if (_passphrase)
            {
                var o = new PassphraseOptions(Math.Clamp(_words, PasswordGenerator.MinWords, PasswordGenerator.MaxWords), _separator, _capitalize, _number);
                _result = PasswordGenerator.GeneratePassphrase(o);
                _bits = PasswordGenerator.PassphraseEntropyBits(o);
            }
            else
            {
                var o = new PasswordOptions(Math.Clamp(_length, PasswordGenerator.MinLength, PasswordGenerator.MaxLength), _upper, _lower, _digits, _symbols, _noAmbiguous);
                _result = PasswordGenerator.Generate(o);
                _bits = PasswordGenerator.EntropyBits(o);
            }

            _strength = PasswordGenerator.Rate(_bits);
        }
        catch (ArgumentException)
        {
            _result = string.Empty;
            _error = L["pw.noclass"];
        }
    }
}
