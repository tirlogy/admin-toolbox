@* Line icons for navigation, tool cards and the theme button. Same paths as the static shell in wwwroot/index.html. *@
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "mail":
            <rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 7l8.5 6 8.5-6" />
            break;
        case "header":
            <path d="M4 6h16M4 12h11M4 18h7" /><circle cx="18" cy="17" r="2.5" />
            break;
        case "subnet":
            <circle cx="12" cy="5" r="2.5" /><circle cx="5" cy="19" r="2.5" /><circle cx="19" cy="19" r="2.5" /><path d="M12 7.5v4M12 11.5l-5.5 5.5M12 11.5l5.5 5.5" />
            break;
        case "diff":
            <path d="M4 8h15l-3.5-3.5M20 16H5l3.5 3.5" />
            break;
        case "helpers":
            <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z" />
            break;
        case "light":
            <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            break;
        case "dark":
            <path d="M20.5 13.5A8.5 8.5 0 1 1 10.5 3.5a6.5 6.5 0 0 0 10 10z" />
            break;
        case "arrow":
            <path d="M5 12h14M13 6l6 6-6 6" />
            break;
        default:
            <rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
}
