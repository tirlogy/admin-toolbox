@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Nav

<a class="skip-link" href="@SkipHref">@T["skip"]</a>
<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="">
            <Logo Size="32" />
            <span>Admin Toolbox</span>
        </a>
        <div class="header-controls">
            <label class="sr-only" for="lang-select">@T["language"]</label>
            <select id="lang-select" class="compact" value="@_lang" @onchange="ChangeLanguageAsync">
                <option value="de">Deutsch</option>
                <option value="en">English</option>
                <option value="tr">Türkçe</option>
            </select>
            <button type="button" class="icon-button" @onclick="CycleThemeAsync" aria-label="@T["theme." + _theme]" title="@T["theme." + _theme]">
                <Icon Name="@_theme" />
            </button>
        </div>
    </div>
    <nav class="container main-nav" aria-label="@T["nav"]">
        @foreach (var (key, href) in NavItems)
        {
            <NavLink href="@href"><Icon Name="@key" /><span class="nav-long">@T["tool." + key]</span><span class="nav-short">@T["tool." + key + ".short"]</span></NavLink>
        }
    </nav>
</header>

<main id="main" class="container" tabindex="-1">
    @Body
</main>

<footer class="site-footer">
    <div class="container footer-inner">
        <p>Built by Ömer Tiryaki · <a href="https://tiryaki.eu" rel="noopener">tiryaki.eu</a></p>
        <p>
            <a href="privacy">@T["privacy"]</a> ·
            <a href="https://tiryaki.eu/impressum" rel="noopener">@T["imprint"]</a> ·
            <a href="https://github.com/tirlogy/admin-toolbox" rel="noopener">GitHub</a> ·
            <span>MIT</span>
        </p>
    </div>
</footer>

@code {
    private static readonly (string Key, string Href)[] NavItems =
    {
        ("mail", "mail"), ("header", "header"), ("subnet", "subnet"), ("diff", "dns-diff"), ("helpers", "helpers"),
    };

    private string _lang = System.Globalization.CultureInfo.CurrentUICulture.Name;
    private string _theme = "system";

    private string SkipHref => Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0] + "#main";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _theme = await JS.InvokeAsync<string>("atb.theme");
            StateHasChanged();
        }
        catch (JSException)
        {
        }
    }

    private async Task ChangeLanguageAsync(ChangeEventArgs e)
    {
        await JS.InvokeVoidAsync("atb.setLang", e.Value?.ToString());
    }

    private async Task CycleThemeAsync()
    {
        _theme = _theme switch { "system" => "light", "light" => "dark", _ => "system" };
        await JS.InvokeVoidAsync("atb.setTheme", _theme);
    }
}
